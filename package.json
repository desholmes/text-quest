{
  "name": "text-quest",
  "version": "1.0.0",
  "private": true,
  "description": "Text Quest: Unlock your imagination",
  "repository": "https://github.com/desholmes/text-quest",
  "scripts": {
    "social-image-add": "f() { cp ./src/images/text-quest-social-cover.png ./dist-$1/; }; f",
    "clean": "f() { rm -rf ./dist-$1/*.css ./dist-$1/*.map ./dist-$1/*.html ./dist-$1/*.js ./dist-$1/*.jpg ./dist-$1/*.png ./dist-$1/*.ico; }; f",
    "start": "f() { exec parcel --dist-dir=dist-$1 ./src/games/$1/index.html; }; f",
    "build": "f() { npm run clean -- $1 && parcel build --no-cache --dist-dir=dist-$1 ./src/games/$1/index.html && npm run social-image-add -- $1; }; f",
    "build:serve": "f() { exec serve dist-$1/; }; f",
    "prettier": "prettier --check ./src/",
    "prettier:fix": "prettier --write ./src/",
    "lint": "eslint --max-warnings=0 --config=eslint.config.mjs ./src/",
    "lint:fix": "eslint --max-warnings=0 --fix --config=eslint.config.mjs ./src/",
    "prettier-lint:fix": "npm run prettier:fix && npm run lint:fix"
  },
  "author": "Des Holmes https://github.com/desholmes",
  "license": "MIT",
  "devDependencies": {
    "@parcel/transformer-image": "2.16.4",
    "@parcel/transformer-yaml": "2.16.4",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "parcel": "2.16.4",
    "prettier": "3.9.6",
    "serve": "14.2.6"
  },
  "dependencies": {
    "text-terminal": "0.2.0"
  },
  "browserslist": ["> 0.5%", "last 2 versions", "not dead"],
  "engines": {
    "node": ">=24.15.0"
  }
}
